# Copy to .env.local for local dev, and add the same vars in your host's dashboard
# (Vercel: Project → Settings → Environment Variables). Never commit real keys.

# Venice inference key (NOT an admin key). Create one at https://venice.ai/settings/api
# and give it a spending limit.
VENICE_API_KEY=

# Optional: which Venice model powers Santa (default: deepseek-v4-1-flash-1017)
# VENICE_MODEL=deepseek-v4-1-flash-1017

# Optional: Santa's voice (defaults: tts-kokoro + am_santa)
# VENICE_TTS_MODEL=tts-kokoro
# VENICE_TTS_VOICE=am_santa

# Santa Clips video model (default grok-imagine-1-5-lite-image-to-video)
# VENICE_VIDEO_MODEL=

# Storage for cookies + clip jobs (Vercel → Storage → Upstash Redis fills these in)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Solana RPC for $SANTA balances (public RPC rate-limits; Helius/QuickNode free tier is better)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Signs wallet sessions: any long random string
# SESSION_SECRET=

# Only needed to re-run `npm run make-santa` (regenerates the 3D model)
# MESHY_API_KEY=
